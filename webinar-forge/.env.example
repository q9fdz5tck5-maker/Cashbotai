# ── Voice engine ──────────────────────────────────────────────────────────
# Where the voice engine listens / where the generator looks for it.
VOICE_ENGINE_URL=http://127.0.0.1:5651
VOICE_HOST=127.0.0.1
VOICE_PORT=5651

# Force a torch device. Leave unset to auto-detect (cuda -> mps -> cpu).
# VOICE_DEVICE=cuda

# ── Binaries (leave unset to auto-detect from PATH) ───────────────────────
# FFMPEG_PATH=/usr/bin/ffmpeg
# FFPROBE_PATH=/usr/bin/ffprobe
# CHROME_PATH=/usr/bin/chromium

# ── Render tuning ─────────────────────────────────────────────────────────
# Parallel ffmpeg segment renders. Raise on big servers, lower on small VPSes.
RENDER_CONCURRENCY=4
# Parallel TTS requests. Keep at 1 on CPU-only boxes; 2-4 on a GPU.
TTS_CONCURRENCY=1
