#!/usr/bin/env node
'use strict';

const fs = require('fs');
const path = require('path');
const ROOT = path.resolve(__dirname, '..');

// Load .env if present, without adding a dependency.
const envFile = path.join(ROOT, '.env');
if (fs.existsSync(envFile)) {
  for (const line of fs.readFileSync(envFile, 'utf8').split('\n')) {
    const m = /^\s*([A-Z_][A-Z0-9_]*)\s*=\s*(.*)\s*$/i.exec(line);
    if (m && !(m[1] in process.env)) {
      process.env[m[1]] = m[2].replace(/^["']|["']$/g, '');
    }
  }
}

const USAGE = `
webinar-forge — build a narrated webinar video from a project config

  webinar-forge build <project.json> [options]
  webinar-forge doctor                       check this machine can build
  webinar-forge voices                       list voices installed on the engine
  webinar-forge add-voice <name> <sample>    install a voice sample (wav/mp3, 10-30s)
  webinar-forge init <dir>                   scaffold a new project from the example

Options
  --output <dir>    where to write artifacts        (default ./output)
  --force           rebuild everything, ignore cache
  --only <stage>    stop after: deck | narrate | capture

Environment (or .env)
  VOICE_ENGINE_URL   default http://127.0.0.1:5651
  RENDER_CONCURRENCY parallel ffmpeg jobs   (default 4)
  TTS_CONCURRENCY    parallel TTS requests  (default 1)
`;

function parseArgs(argv) {
  const positional = [];
  const flags = {};
  for (let i = 0; i < argv.length; i++) {
    const a = argv[i];
    if (a === '--force') flags.force = true;
    else if (a === '--output') flags.output = argv[++i];
    else if (a === '--only') flags.only = argv[++i];
    else if (a === '-h' || a === '--help') flags.help = true;
    else positional.push(a);
  }
  return { positional, flags };
}

async function cmdDoctor() {
  const { resolveAll } = require('../src/paths');
  const narrate = require('../src/narrate');
  const bins = resolveAll();
  let bad = 0;

  console.log('\nBinaries');
  for (const [name, p] of Object.entries(bins)) {
    console.log(`  ${p ? 'ok  ' : 'MISS'}  ${name.padEnd(8)} ${p || '(not found)'}`);
    if (!p) bad++;
  }

  console.log('\nNode modules');
  try {
    require.resolve('puppeteer-core');
    console.log('  ok    puppeteer-core');
  } catch {
    console.log('  MISS  puppeteer-core  — run: npm install');
    bad++;
  }

  console.log(`\nVoice engine (${narrate.engineUrl()})`);
  try {
    const h = await narrate.health();
    console.log(`  ok    status=${h.status} device=${h.device}`);
    const { voices } = await narrate.listVoices();
    const names = (voices || []).map((v) => v.name);
    console.log(`  ${names.length ? 'ok  ' : 'WARN'}  voices: ${names.join(', ') || '(none installed)'}`);
    if (!names.length) bad++;
  } catch (e) {
    console.log(`  MISS  ${e.message}`);
    console.log('        start it with ./engine/start.sh, or npm run mock-engine for a dry run');
    bad++;
  }

  console.log(bad === 0 ? '\nReady to build.\n' : `\n${bad} problem(s) above must be fixed first.\n`);
  process.exit(bad === 0 ? 0 : 1);
}

async function cmdVoices() {
  const { listVoices, engineUrl } = require('../src/narrate');
  const { voices } = await listVoices();
  if (!voices || !voices.length) {
    console.log(`No voices installed on ${engineUrl()}.`);
    console.log('Add one:  webinar-forge add-voice <name> <sample.wav>');
    return;
  }
  console.log(`Voices on ${engineUrl()}:`);
  for (const v of voices) {
    const kb = (v.size / 1024).toFixed(0);
    console.log(`  ${v.name.padEnd(20)} ${String(kb).padStart(7)} KB  ${v.preprocessed ? 'preprocessed' : 'raw'}`);
  }
}

async function cmdAddVoice(name, samplePath) {
  const { engineUrl } = require('../src/narrate');
  if (!name || !samplePath) throw new Error('Usage: webinar-forge add-voice <name> <sample.wav>');
  if (!fs.existsSync(samplePath)) throw new Error(`Sample not found: ${samplePath}`);

  const safe = name.toLowerCase().replace(/[^a-z0-9_-]+/g, '-');
  const buf = fs.readFileSync(samplePath);
  const form = new FormData();
  form.append('file', new Blob([buf]), path.basename(samplePath));
  form.append('name', safe);

  const res = await fetch(`${engineUrl()}/upload-sample`, { method: 'POST', body: form });
  if (!res.ok) throw new Error(`upload-sample ${res.status}: ${(await res.text()).slice(0, 300)}`);
  const json = await res.json();
  console.log(`Installed voice "${safe}" (${(buf.length / 1024).toFixed(0)} KB, preprocessed: ${json.preprocessed || 'no'})`);
  console.log(`Use it by setting  "voice": { "name": "${safe}" }  in your project.json`);
}

function cmdInit(dir) {
  if (!dir) throw new Error('Usage: webinar-forge init <dir>');
  const target = path.resolve(dir);
  if (fs.existsSync(target)) throw new Error(`Refusing to overwrite existing path: ${target}`);
  fs.mkdirSync(target, { recursive: true });
  const src = path.join(ROOT, 'projects', 'example', 'project.json');
  const cfg = JSON.parse(fs.readFileSync(src, 'utf8'));
  cfg.name = path.basename(target).toLowerCase().replace(/[^a-z0-9_-]+/g, '-');
  fs.writeFileSync(path.join(target, 'project.json'), JSON.stringify(cfg, null, 2) + '\n');
  console.log(`Created ${path.join(target, 'project.json')}`);
  console.log(`Edit it, then:  webinar-forge build ${path.join(dir, 'project.json')}`);
}

async function main() {
  const { positional, flags } = parseArgs(process.argv.slice(2));
  const cmd = positional[0];

  if (!cmd || flags.help) {
    console.log(USAGE);
    process.exit(cmd ? 0 : 1);
  }

  switch (cmd) {
    case 'build': {
      if (!positional[1]) throw new Error('Usage: webinar-forge build <project.json>');
      const { build } = require('../src/pipeline');
      await build(positional[1], flags);
      break;
    }
    case 'doctor':    await cmdDoctor(); break;
    case 'voices':    await cmdVoices(); break;
    case 'add-voice': await cmdAddVoice(positional[1], positional[2]); break;
    case 'init':      cmdInit(positional[1]); break;
    default:
      console.error(`Unknown command: ${cmd}`);
      console.log(USAGE);
      process.exit(1);
  }
}

main().catch((e) => {
  console.error(`\nERROR  ${e.message}\n`);
  process.exit(1);
});
